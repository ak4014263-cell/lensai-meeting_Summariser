# Copy to `.env` and adjust. Every value has a sensible default, so an empty
# .env works. See README for details.

# ── Storage ──────────────────────────────────────────────────────────────
# STORAGE_DIR=C:/path/to/recordings

# ── Ollama (LLM) ───────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
# Installed models on this machine: llama3, llama3.2. llama3.2 is faster/smaller.
OLLAMA_MODEL=llama3
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# Characters per map-reduce chunk for long meetings.
LLM_CHUNK_CHARS=6000

# ── Whisper (speech to text) ───────────────────────────────────────────────
# tiny | base | small | medium | large-v3. Bigger = more accurate, slower.
WHISPER_MODEL=small
# cpu, or cuda if you have an NVIDIA GPU (also set WHISPER_COMPUTE_TYPE=float16).
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave blank to auto-detect language, or set e.g. en / hi / es.
# WHISPER_LANGUAGE=

# ── Speech to text backend ─────────────────────────────────────────────────
# local  = faster-whisper on this machine (default; no audio leaves the host)
# openai = OpenAI /v1/audio/transcriptions
STT_BACKEND=local
OPENAI_API_KEY=
# whisper-1 is the only OpenAI STT model that returns segment timestamps, which
# speaker attribution depends on. The gpt-4o-transcribe family does not.
OPENAI_STT_MODEL=whisper-1
# Uploads are capped at 25 MB; larger or unsupported audio (e.g. the .flac the
# hosted bot downloads) is re-encoded to 16 kHz mono WAV and split into windows.
OPENAI_CHUNK_SECONDS=600

# ── Calendar invitations ───────────────────────────────────────────────────
# Whether creating a meeting from the portal makes Google email the guests.
# all = email everyone | externalOnly = non-Google guests only | none = silent.
# The Calendar API defaults to "none", so this has to be sent explicitly.
CALENDAR_SEND_INVITES=all

# ── Meeting bot ────────────────────────────────────────────────────────────
BOT_DISPLAY_NAME=AI Notetaker
# Google Meet blocks headless Chrome. Keep this false on a desktop.
# On a Linux server, run under Xvfb and you may set it true.
BOT_HEADLESS=false
# Use a locally installed browser for best Meet compatibility: chrome | msedge.
# Leave blank to use Playwright's bundled Chromium.
BOT_BROWSER_CHANNEL=
# Point at a Chrome profile dir to join as a signed-in Google account
# (often skips the waiting room). Leave blank to join as an anonymous guest.
BOT_USER_DATA_DIR=
# How long to wait to be admitted from the waiting room (seconds).
BOT_ADMISSION_TIMEOUT=300
# Once every human leaves, seconds to confirm before the bot leaves too.
BOT_ALONE_GRACE_SECONDS=30
# Hard safety cap on one recording (minutes).
BOT_MAX_MEETING_MINUTES=180
# Simultaneous meetings the bot may record.
BOT_MAX_CONCURRENT=3

# ── Auth ───────────────────────────────────────────────────────────────────
# CHANGE THIS in any deployment reachable by anyone but you.
SECRET_KEY=supersecretkey_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend ───────────────────────────────────────────────────────────────
# Where the Google OAuth callback returns the browser to.
FRONTEND_BASE_URL=http://localhost:3000

# ── Google OAuth / Meet REST API (optional) ─────────────────────────────────
# From a Google Cloud "Web application" OAuth client. See docs/GOOGLE_MEET_API.md.
# Leave blank to disable the "Connect Google account" feature. Alternatively,
# drop the downloaded client_secret.json into backend/ and leave these blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be added verbatim to the OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback

# ── Meeting BaaS (hosted bot service) ───────────────────────────────────────
MEETINGBAAS_API_KEY=
MEETINGBAAS_BOT_NAME=LensAi Bot
# Public https URL of the bot avatar (the LensAi logo). Must be reachable by
# Meeting BaaS (not localhost). Leave blank for no avatar.
MEETINGBAAS_BOT_IMAGE_URL=
# Production webhook delivery: public https URL ending in /webhooks/meetingbaas.
# Blank = poll instead (fine for local dev).
MEETINGBAAS_WEBHOOK_URL=
MEETINGBAAS_WEBHOOK_SECRET=
MEETINGBAAS_POLL_FALLBACK=true
# Space-separated OAuth scopes (defaults are usually fine).
# GOOGLE_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/meetings.space.readonly
